generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Autor {
  id           Int     @id @default(autoincrement())
  nombre       String  @unique
  nacionalidad String
  biografia    String
  libros       Libro[]
}

model Libro {
  id          Int         @id @default(autoincrement())
  titulo      String
  genero      String
  descripcion String
  imagen      String
  autorId     Int
  autor       Autor       @relation(fields: [autorId], references: [id], onDelete: Restrict)
  categorias  Categoria[]
}

model Categoria {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  libros Libro[]
}

enum Rol {
  ADMIN
  CLIENTE
}

model Usuario {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  nombre       String
  rol          Rol      @default(CLIENTE)
  creadoEn     DateTime @default(now())
}