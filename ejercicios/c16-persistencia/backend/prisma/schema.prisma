generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Libro {
  id          Int    @id @default(autoincrement())
  titulo      String
  autor       String
  genero      String
  descripcion String
  imagen      String
}

model Autor {
  id           Int    @id @default(autoincrement())
  nombre       String @unique
  nacionalidad String
  biografia    String
}